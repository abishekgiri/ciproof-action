{
  "name": "ciproof-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action that runs CIProof — behavioral verification for GitHub Actions with concrete counterexamples.",
  "license": "MIT",
  "author": "Abishek Giri",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:check": "node scripts/verify-dist.mjs",
    "all": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run package:check"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.8",
    "yaml": "^2.9.1"
  }
}
